@model (string BindingName, DateRangeFilterViewModel Range)

@{
    string bindingName = $"Filters[{Model.BindingName}].DateRange";
    string idPrefix = $"filter-{Model.BindingName.Replace("_", "-")}";

    string? fromError = ViewData.ModelState[$"{bindingName}.From"]?.Errors.FirstOrDefault()?.ErrorMessage;
    string? toError = ViewData.ModelState[$"{bindingName}.To"]?.Errors.FirstOrDefault()?.ErrorMessage;
}


<div class="govuk-form-group">
    <fieldset class="govuk-fieldset" role="group">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
            <h1 class="govuk-fieldset__heading">
                From
            </h1>
        </legend>

        @if (fromError is not null)
        {
            <p id="@($"{idPrefix}-from-error")"
               class="govuk-error-message">
                <span>@fromError</span>
            </p>
        }

        <div class="govuk-date-input">
            <div class="govuk-date-input__item">
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-date-input__label">
                        Day
                    </label>
                    <input for=@($"{idPrefix}-from-day")
                           class="govuk-input govuk-date-input__input @(fromError is not null ? "govuk-input--error" : "") govuk-input--width-2"
                           name=@($"{bindingName}.From.Day")
                           value="@Model.Range.From.Day"
                           type="text"
                           inputmode="numeric">
                </div>
            </div>
            <div class="govuk-date-input__item">
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-date-input__label">
                        Month
                    </label>
                    <input for=@($"{idPrefix}-from-month")
                           class="govuk-input govuk-date-input__input @(fromError is not null ? "govuk-input--error" : "") govuk-input--width-2"
                           name=@($"{bindingName}.From.Month")
                           value="@Model.Range.From.Month"
                           type="text"
                           inputmode="numeric">
                </div>
            </div>
            <div class="govuk-date-input__item">
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-date-input__label">
                        Year
                    </label>
                    <input for=@($"{idPrefix}-from-year")
                           class="govuk-input govuk-date-input__input @(fromError is not null ? "govuk-input--error" : "") govuk-input--width-4"
                           name=@($"{bindingName}.From.Year")
                           value="@Model.Range.From.Year"
                           type="text"
                           inputmode="numeric">
                </div>
            </div>
        </div>
    </fieldset>
</div>

<div class="govuk-form-group">
    <fieldset class="govuk-fieldset" role="group">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
            <h1 class="govuk-fieldset__heading">
                To
            </h1>
        </legend>

        @if (toError is not null)
        {
            <p id="@($"{idPrefix}-to-error")"
               class="govuk-error-message">
                <span>@toError</span>
            </p>
        }

        <div class="govuk-date-input">
            <div class="govuk-date-input__item">
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-date-input__label">
                        Day
                    </label>
                    <input for=@($"{idPrefix}-to-day")
                           class="govuk-input govuk-date-input__input @(toError is not null ? "govuk-input--error" : "") govuk-input--width-2"
                           name=@($"{bindingName}.To.Day")
                           value="@Model.Range.To.Day"
                           type="text"
                           inputmode="numeric">
                </div>
            </div>
            <div class="govuk-date-input__item">
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-date-input__label">
                        Month
                    </label>
                    <input for=@($"{idPrefix}-to-month")
                           class="govuk-input govuk-date-input__input @(toError is not null ? "govuk-input--error" : "") govuk-input--width-2"
                           name=@($"{bindingName}.To.Month")
                           value="@Model.Range.To.Month"
                           type="text"
                           inputmode="numeric">
                </div>
            </div>
            <div class="govuk-date-input__item">
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-date-input__label">
                        Year
                    </label>
                    <input for=@($"{idPrefix}-to-year")
                           class="govuk-input govuk-date-input__input @(toError is not null ? "govuk-input--error" : "") govuk-input--width-4"
                           name=@($"{bindingName}.To.Year")
                           value="@Model.Range.To.Year"
                           type="text"
                           inputmode="numeric">
                </div>
            </div>
        </div>
    </fieldset>
</div>
