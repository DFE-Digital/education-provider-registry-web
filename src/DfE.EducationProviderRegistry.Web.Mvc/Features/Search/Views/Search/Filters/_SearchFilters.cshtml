@using DfE.EducationProviderRegistry.Web.Mvc.Features.Search.ViewModels
@using DfE.EducationProviderRegistry.Web.Mvc.Features.Search.ViewModels.Filters

@model SearchResultsViewModel

@{
    List<(IFilterViewModel Filter, SelectedFilterValueViewModel Value)> selectedFilters =
        Model.Filters
            .SelectMany(filter =>
                filter.SelectedValues.Select(selectedValue =>
                    (
                        Filter: filter,
                        Value: selectedValue
                    )))
            .ToList();
}

<div class="moj-filter">
    <div class="moj-filter__content">
        <div class="moj-filter__options">

            @if (selectedFilters.Count > 0)
            {
                <div class="moj-filter__selected app-selected-filters">
                    <div class="app-selected-filters__header">
                        <h2 class="govuk-heading-s">
                            Selected filters
                        </h2>

                        <button type="submit"
                                name="ClearFilters"
                                value="true"
                                class="govuk-link app-selected-filters__clear">
                            Clear filters
                        </button>
                    </div>

                    <ul class="app-selected-filters__list">
                        @foreach ((IFilterViewModel filter, SelectedFilterValueViewModel selectedValue) in selectedFilters)
                        {
                            string removeValue =
                                selectedValue.Value is null
                                    ? $"{filter.Name}|filter"
                                    : $"{filter.Name}|{selectedValue.Value}";

                            <li>
                                <button type="submit"
                                        class="app-selected-filter"
                                        name="RemoveFilter"
                                        value="@removeValue">

                                    @selectedValue.Label

                                    <span aria-hidden="true">
                                        &times;
                                    </span>

                                    <span class="govuk-visually-hidden">
                                        Remove @selectedValue.Label filter
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }

            @foreach (IFilterViewModel filter in Model.Filters ?? [])
            {
                <details class="govuk-details filter-section">
                    <summary class="govuk-details__summary">
                        <span class="govuk-details__summary-text">
                            @filter.Label
                        </span>
                    </summary>

                    <div class="govuk-details__text">
                        @switch (filter)
                        {
                            case CheckboxFilterViewModel checkbox:
                                @await Html.PartialAsync(
                                    "_FiltersCheckboxComponent",
                                    checkbox)
                                break;

                            case AutocompleteFilterViewModel autocomplete:
                                @await Html.PartialAsync(
                                    "_AutocompleteFilter",
                                    autocomplete)
                                break;

                            case DateRangeFilterViewModel dateRange:
                                @await Html.PartialAsync(
                                    "_DateRangeFilter",
                                    dateRange)
                                break;

                            case NumberRangeFilterViewModel numberRange:
                                @await Html.PartialAsync(
                                    "_NumberRangeFilter",
                                    numberRange)
                                break;

                            default:
                                break;
                        }
                    </div>
                </details>
            }

            <button type="submit"
                    class="govuk-button"
                    data-module="govuk-button">
                Apply filters
            </button>

        </div>
    </div>
</div>
