@using DfE.EducationProviderRegistry.Web.Mvc.Features.Groups
@using DfE.EducationProviderRegistry.Web.ViewComponents.Paragraph
@using DfE.EducationProviderRegistry.Web.ViewComponents.Tabs
@model GroupDetailsPageViewModel

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">@Model.Heading</h1>
    </div>
    <div class="govuk-grid-column-one-third">
        <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">
            Download information
        </button>
    </div>
</div>

<div>
    @await Component.InvokeAsync(
        "GovUkTabs",
        new GovUkTabs(
        [
            new Tab(
                id: "details",
                title: "Details",
                contents:
                [
                    new TabContent(
                        viewComponentName: "GovUkTable",
                        model: Model.Details.Table)
                ]),

            new Tab(
                id: "establishments",
                title: Model.Establishments.Tab ?? "",
                contents: 
                [
                    Model.Establishments.HasEstablishments ?
                    new TabContent(
                        viewComponentName: "GovUkTable",
                        model: Model.Establishments.Table) :
                    new TabContent(
                        viewComponentName: "Paragraph",
                        model: new Paragraph(Model.Establishments.NoEstablishmentsMessage! ?? string.Empty))
                ]),

            new Tab(
                id: "governance",
                title: "Governance",
                contents:
                [
                    new TabContent(
                        viewComponentName: "GovUkTable",
                        model: Model.Governance.TrusteesTable),

                    new TabContent(
                        viewComponentName: "GovUkTable",
                        model: Model.Governance.MembersTable)
                ])
        ]))
</div>
