{
  "AccessibilityTestOptions": {
    "ArtifactsOutputDirectory": "artifacts",
    "WcagTags": [
      "wcag2a",
      "wcag2aa",
      "wcag21a",
      "wcag21aa",
      "wcag22a",
      "wcag22aa"
    ],
    "Scans": {
      "Home": {
        "Actions": [
          {
            "Name": "navigate",
            "Options": {
              "route": "/"
            }
          }
        ]
      },
      "Search": {
        "Actions": [
          {
            "Name": "navigate",
            "Options": {
              "route": "/search"
            }
          }
        ]
      },
      "SearchResults": {
        "Actions": [
          {
            "Name": "navigate",
            "Options": {
              "route": "/search"
            }
          },
          {
            "Name": "enter",
            "Options": {
              "target": "#SearchKeywords",
              "text": "sch"
            }
          },
          {
            "Name": "click",
            "Options": {
              "target": ".dfe-search-panel [type=submit]"
            }
          }
        ]
      },
      "Establishment_ById": {
        "Actions": [
          {
            "Name": "navigate",
            "Options": {
              "route": "/establishments/100001"
            }
          }
        ]
      },
      "Group_ById": {
        "Actions": [
          {
            "Name": "navigate",
            "Options": {
              "route": "/groups/1"
            }
          }
        ]
      }
    }
  },
  "ContainerNetworkOptions": {
    "Networks": [
      {
        "Name": "epr-accessibility-tests"
      }
    ]
  },
  "ContainerOptions": {
    "Registry": "ghcr.io",
    "Owner": "dfe-digital",
    "ImageName": "education-provider-registry-web",
    "ImageTag": "{APPLICATION_IMAGE_TAG}",
    "Digest": "",
    "StartupArguments": [],
    "PortMappings": [
      {
        "ContainerPort": 8080,
        "PublicPort": null
      }
    ],
    "Networks": [
      {
        "Key": "epr-accessibility-tests"
      }
    ]
  },
  "PostgresContainerOptions": {
    "Container": {
      "Registry": "ghcr.io",
      "Owner": "dfe-digital",
      "ImageName": "education-provider-registry-data-postgres",
      "ImageTag": "main",
      "Digest": "",
      "StartupArguments": [],
      "PortMappings": [
        {
          "ContainerPort": 5432,
          "PublicPort": null
        }
      ],
      "Networks": [
        {
          "Key": "epr-accessibility-tests",
          "Aliases": [ "epr-postgres" ]
        }
      ]
    },
    "Database": {
      "Name": "postgres",
      "Username": "postgres",
      "Password": "postgres"
    }
  }
}