@model (string BindingName, NumberRangeFilterViewModel Range)

@{
    string bindingName = $"DateRanges[{Model.BindingName}]";
    string idPrefix = $"filter-{Model.BindingName.Replace("_", "-")}";
}

<div>
    <label class="govuk-label govuk-label--s" for=@($"{idPrefix}-from")>
        From
    </label>
    <input class="govuk-input govuk-input--width-2"
           id=@($"{idPrefix}-from")
           name=@($"{bindingName}.From")
           type="text"
           inputmode="numeric">
</div>

<div>
    <label class="govuk-label govuk-label--s" for=@($"{idPrefix}-to")>
        To
    </label>
    <input class="govuk-input govuk-input--width-2"
           id=@($"{idPrefix}-to")
           name=@($"{bindingName}.To")
           type="text"
           inputmode="numeric">
</div>
