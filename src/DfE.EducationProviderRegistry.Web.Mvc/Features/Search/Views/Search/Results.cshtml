@using DfE.EducationProviderRegistry.Web.Mvc.Features.Search.ViewModels
@using DfE.EducationProviderRegistry.Web.ViewComponents.Table
@using DfE.EducationProviderRegistry.Web.ViewComponents.Tabs
@model SearchResultsViewModel

<h1 class="govuk-heading-xl">
    @if (!string.IsNullOrWhiteSpace(Model.PrimarySearchTerms))
    {
        <span>
            Search results for "@Model.PrimarySearchTerms"

            @if (!string.IsNullOrWhiteSpace(Model.SecondarySearchTerms))
            {
                <text> "@Model.SecondarySearchTerms"</text>
            }
        </span>
    }
</h1>

<form asp-action="Search"
      asp-controller="Search"
      method="post">

    @await Html.PartialAsync("_SearchPanel", Model.SearchRequest)

    <div class="govuk-grid-row">

        <div class="govuk-grid-column-one-third">
            <div class="filter-panel">

                <div class="filter-panel__title">
                    <h2 class="govuk-heading-m govuk-!-margin-bottom-0">
                        Filter
                    </h2>
                </div>

                @await Html.PartialAsync("_SearchFilters", Model.Facets)

            </div>
        </div>

        <div class="govuk-grid-column-two-thirds">

            @if (Model.HasResults)
            {
                @await Html.PartialAsync("_SearchResultsHeader", Model)

                <div class="search-results">

                    @await Component.InvokeAsync(
                        "GovUkTabs",
                        new GovUkTabs(
                        [
                            new Tab(
                                id: "establishments",
                                title: $"Establishments ({Model.TotalEstablishmentResults})",
                                contents:
                                    Model.EstablishmentResults
                                        .Select(result =>
                                            new TabContent(
                                                viewComponentName: "SharedGovUkTable",
                                                model: result))
                                        .ToList()
                            ),

                            new Tab(
                                id: "establishmentsGroups",
                                title: "Establishments groups",
                                contents:
                                [
                                    new TabContent(
                                        "SharedGovUkTable",
                                        new GovUkTable(
                                            [
                                                new TableColumn
                                                {
                                                    Text = "Placeholder"
                                                }
                                            ],
                                            [
                                                new TableRow
                                                {
                                                    Cells =
                                                    [
                                                        new TableCell
                                                        {
                                                            Text = "Sample Cell"
                                                        }
                                                    ]
                                                }
                                            ]))
                                ]
                            )
                        ]))

                </div>

                @await Html.PartialAsync("_SearchPagination", Model)
            }
            else
            {
                <p class="govuk-body">
                    No results found.
                </p>
            }

        </div>

    </div>

</form>