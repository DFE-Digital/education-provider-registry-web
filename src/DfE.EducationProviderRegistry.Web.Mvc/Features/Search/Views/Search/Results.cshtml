@using DfE.EducationProviderRegistry.Web.Mvc.Features.Search.ViewModels.Results
@using Microsoft.AspNetCore.Mvc.ModelBinding
@model SearchResultsViewModel

@{
    ViewData["Title"] = "Search results";

    List<string> searchTerms = [];

    if (!string.IsNullOrWhiteSpace(Model.PrimarySearchTerms))
        searchTerms.Add($"\"{Model.PrimarySearchTerms}\"");

    if (!string.IsNullOrWhiteSpace(Model.SecondarySearchTerms))
        searchTerms.Add($"\"{Model.SecondarySearchTerms}\"");

    string searchDisplayText = string.Join(" ", searchTerms);
}

@if (!string.IsNullOrWhiteSpace(searchDisplayText))
{
    <h1 class="govuk-heading-xl">
        Search results for @searchDisplayText
    </h1>
}

<form asp-action="Search"
      asp-controller="Search"
      method="get">

    @await Html.PartialAsync("_SearchPanel", Model.SearchRequest)

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="govuk-error-summary"
             data-module="govuk-error-summary"
             tabindex="-1">
            <div role="alert">
                <h2 class="govuk-error-summary__title">
                    There is a problem
                </h2>

                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        @foreach (KeyValuePair<string, ModelStateEntry> entry in ViewData.ModelState)
                        {
                            string? targetId = FilterInputIdModelStateMapping.ForModelStateKey(entry.Key);

                            foreach (ModelError error in entry.Value.Errors)
                            {
                                <li>
                                    @if (targetId is not null)
                                    {
                                        <a href="#@targetId">
                                            @error.ErrorMessage
                                        </a>
                                    }
                                    else
                                    {
                                        @error.ErrorMessage
                                    }
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <div class="govuk-grid-row">

        <div class="govuk-grid-column-one-third">
            <div class="filter-panel">

                <div class="filter-panel__title">
                    <h2 class="govuk-heading-m govuk-!-margin-bottom-0">
                        Filter
                    </h2>
                </div>

                @await Html.PartialAsync("_SearchFilters", Model)

            </div>
        </div>

        <div class="govuk-grid-column-two-thirds">

            @if (Model.HasResults)
            {
                @await Html.PartialAsync("_SearchResultsHeader", Model)

                <div class="search-results">

                    @foreach (var result in Model.SearchAggregateResults)
                    {
                        @await Component.InvokeAsync("GovUkTable", result)
                    }

                </div>

                @await Html.PartialAsync("_SearchPagination", Model)
            }
            else
            {
                <p class="govuk-body">
                    No results found.
                </p>
            }

        </div>

    </div>

</form>
