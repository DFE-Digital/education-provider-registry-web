<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">Download datasets</h1>
        <p class="govuk-body-l">
            Download datasets from the Department for Education's official records of education providers, provider groups and governance in England.
        </p>
    </div>
</div>

<form asp-action="downloading"
    asp-controller="Datasets"
    method="post">
    @await Html.PartialAsync("_DownloadPanel")
</form>
