@using DfE.EducationProviderRegistry.Web.Mvc.Features.Search
@using DfE.EducationProviderRegistry.Web.Mvc.Features.Search.ViewModels
@model SearchResultsViewModel

@if (Model.TotalPages > 1)
{
    int currentPage = Model.SearchRequest.PageNumber;
    int startPage = Math.Max(1, currentPage - 1);
    int endPage = Math.Min(Model.TotalPages, currentPage + 1);

    <nav class="govuk-pagination"
         aria-label="Pagination">

        @if (Model.HasPreviousPage)
        {
            <div class="govuk-pagination__prev">

                <a class="govuk-link govuk-pagination__link"
                   href="@SearchUrlBuilder.BuildPageUrl(
                                          Url,
                                          Model.SearchRequest,
                                          currentPage - 1)"
                   rel="prev">

                    <svg class="govuk-pagination__icon govuk-pagination__icon--prev"
                         xmlns="http://www.w3.org/2000/svg"
                         height="13"
                         width="15"
                         aria-hidden="true"
                         focusable="false"
                         viewBox="0 0 15 13">
                        <path d="m6.5938-0.0078125-6.7266 6.7266 6.7441 6.4062 1.377-1.449-4.1856-3.9768h12.896v-2h-12.984l4.2931-4.293-1.414-1.414z"></path>
                    </svg>

                    <span class="govuk-pagination__link-title">
                        Previous<span class="govuk-visually-hidden"> page</span>
                    </span>

                </a>

            </div>
        }

        <ul class="govuk-pagination__list">

            @if (startPage > 1)
            {
                <li class="govuk-pagination__item">

                    <a class="govuk-link govuk-pagination__link"
                       href="@SearchUrlBuilder.BuildPageUrl(
                                                  Url,
                                                  Model.SearchRequest,
                                                  1)"
                       aria-label="Page 1">
                        1
                    </a>

                </li>
            }

            @if (startPage > 2)
            {
                <li class="govuk-pagination__item govuk-pagination__item--ellipsis">
                    &ctdot;
                </li>
            }

            @for (int pageNumber = startPage;
                  pageNumber <= endPage;
                  pageNumber++)
            {
                bool isCurrentPage =
                    pageNumber == currentPage;

                <li class="govuk-pagination__item @(isCurrentPage ? "govuk-pagination__item--current" : null)">

                    <a class="govuk-link govuk-pagination__link"
                       href="@SearchUrlBuilder.BuildPageUrl(
                                                  Url,
                                                  Model.SearchRequest,
                                                  pageNumber)"
                       aria-label="Page @pageNumber"
                       aria-current="@(isCurrentPage ? "page" : null)">
                        @pageNumber
                    </a>

                </li>
            }

            @if (endPage < Model.TotalPages - 1)
            {
                <li class="govuk-pagination__item govuk-pagination__item--ellipsis">
                    &ctdot;
                </li>
            }

            @if (endPage < Model.TotalPages)
            {
                <li class="govuk-pagination__item">

                    <a class="govuk-link govuk-pagination__link"
                       href="@SearchUrlBuilder.BuildPageUrl(
                                                  Url,
                                                  Model.SearchRequest,
                                                  Model.TotalPages)"
                       aria-label="Page @Model.TotalPages">
                        @Model.TotalPages
                    </a>

                </li>
            }

        </ul>

        @if (Model.HasNextPage)
        {
            <div class="govuk-pagination__next">

                <a class="govuk-link govuk-pagination__link"
                   href="@SearchUrlBuilder.BuildPageUrl(
                                          Url,
                                          Model.SearchRequest,
                                          currentPage + 1)"
                   rel="next">

                    <span class="govuk-pagination__link-title">
                        Next<span class="govuk-visually-hidden"> page</span>
                    </span>

                    <svg class="govuk-pagination__icon govuk-pagination__icon--next"
                         xmlns="http://www.w3.org/2000/svg"
                         height="13"
                         width="15"
                         aria-hidden="true"
                         focusable="false"
                         viewBox="0 0 15 13">
                        <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                    </svg>

                </a>

            </div>
        }

    </nav>
}