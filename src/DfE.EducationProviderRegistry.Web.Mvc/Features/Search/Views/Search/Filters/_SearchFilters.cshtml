@using DfE.EducationProviderRegistry.Web.Mvc.Features.Search.ViewModels
@model SearchResultsViewModel

@{
    var selectedFacets = (Model.Facets ?? [])
        .SelectMany(facet =>
            facet.Values
                .Where(value => value.IsSelected)
                .Select(value => new
                {
                    FacetName = facet.Name,
                    Value = value.Value,
                    Label = value.Label
                }))
        .ToList();

    var openedDate = Model.SearchRequest.Filters
        .GetValueOrDefault("opened_date")?.DateRange ?? new();
    var closedDate = Model.SearchRequest.Filters
        .GetValueOrDefault("closed_date")?.DateRange ?? new();
    var selectedAddtionalFilters = new List<(string Name, string Label, string SelectedLabel)>();

    string? GetDateRangeLabel(DateRangeFilterViewModel range)
    {
        if (range.TryGetRange(out DateOnly from, out DateOnly to))
            return $"{from:dd/MM/yyyy} to {to:dd/MM/yyyy}";
        if (range.To.IsEmpty && range.From.TryGetDate(out from))
            return $"from {from:dd/MM/yyyy}";
        if (range.From.IsEmpty && range.To.TryGetDate(out to))
            return $"to {to:dd/MM/yyyy}";

        return null;
    }


    if (GetDateRangeLabel(openedDate) is { } openedDateLabel)
    {
        selectedAddtionalFilters.Add(("opened_date", "Open date", openedDateLabel));
    }
    if (GetDateRangeLabel(closedDate) is { } closedDateLabel)
    {
        selectedAddtionalFilters.Add(("closed_date", "Close date", closedDateLabel));
    }
}

<div class="moj-filter">
    <div class="moj-filter__content">
        <div class="moj-filter__options">

            @if (selectedFacets.Any() || selectedAddtionalFilters.Any())
            {
                <div class="moj-filter__selected app-selected-filters">
                    <div class="app-selected-filters__header">
                        <h1 class="govuk-heading-s">
                            Selected filters
                        </h1>

                        <button type="submit"
                                name="ClearFilters"
                                value="true"
                                class="govuk-link app-selected-filters__clear">
                            Clear filters
                        </button>
                    </div>

                    <ul class="app-selected-filters__list">
                        @foreach (var filter in selectedAddtionalFilters)
                        {
                            <li>
                                <button type="submit"
                                        class="app-selected-filter"
                                        name="RemoveFilter"
                                        value="@($"{filter.Name}|filter")">

                                    @filter.SelectedLabel

                                    <span aria-hidden="true">&times;</span>
                                    <span class="govuk-visually-hidden">
                                        Remove @filter.Label.ToLowerInvariant() filter
                                    </span>
                                </button>
                            </li>
                        }
                        @foreach (var filter in selectedFacets)
                        {
                            <li>
                                <button type="submit"
                                        class="app-selected-filter"
                                        name="RemoveFilter"
                                        value="@($"{filter.FacetName}|{filter.Value}")">

                                    @filter.Label

                                    <span aria-hidden="true">&times;</span>

                                    <span class="govuk-visually-hidden">
                                        Remove @filter.Label filter
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }

            @foreach (var facet in Model.Facets ?? [])
            {
                <details class="govuk-details filter-section">
                    <summary class="govuk-details__summary">
                        <span class="govuk-details__summary-text">
                            @facet.Label
                        </span>
                    </summary>

                    <div class="govuk-details__text">
                        @if (facet.Name == "LocalAuthority")
                        {
                            @await Html.PartialAsync(
                                "_AutocompleteFilter",
                                facet)
                        }
                        else
                        {
                            @await Html.PartialAsync(
                                "_FiltersCheckboxComponent",
                                facet)
                        }
                    </div>
                </details>
            }

            <details class="govuk-details filter-section">
                <summary class="govuk-details__summary">
                    <span class="govuk-details__summary-text">
                        Open date
                    </span>
                </summary>

                @await Html.PartialAsync("_DateRangeFilter", ("opened_date", openedDate))
            </details>

            <details class="govuk-details filter-section">
                <summary class="govuk-details__summary">
                    <span class="govuk-details__summary-text">
                        Close date
                    </span>
                </summary>

                @await Html.PartialAsync("_DateRangeFilter", ("closed_date", closedDate))
            </details>

            <button type="submit"
                    class="govuk-button"
                    data-module="govuk-button">
                Apply filters
            </button>

        </div>
    </div>
</div>
