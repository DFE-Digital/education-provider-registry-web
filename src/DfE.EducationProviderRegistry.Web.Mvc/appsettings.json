{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "eprweb_eprdat_dotnet_db_connection": "",
    "ClaritySettings": {
        "Enabled": true,
        "ProjectId": "xjrtbo11xp"
    },
    "Breadcrumbs": {
        "Rules": [
            {
                "PathPattern": "/",
                "JourneyResetMode": "Always"
            },
            {
                "PathPattern": "/search",
                "JourneyResetMode": "Always"
            },
            {
                "PathPattern": "/search/results",
                "Title": "Search Results",
                "BaseJourney": [
                    {
                        "Title": "Home",
                        "Url": "/"
                    },
                    {
                        "Title": "Search",
                        "Url": "/search"
                    }
                ]
            },
            {
                "PathPattern": "/establishments",
                "TitleModelProperty": "Heading",
                "JourneyResetMode": "DirectNavigationOnly",
                "BaseJourney": []
            },
            {
                "PathPattern": "/groups",
                "TitleModelProperty": "Heading",
                "JourneyResetMode": "DirectNavigationOnly",
                "BaseJourney": []
            },
            {
                "PathPattern": "/datasets",
                "Title": "Datasets",
                "JourneyResetMode": "Always",
                "BaseJourney": [
                    {
                        "Title": "Home",
                        "Url": "/"
                    }
                ]
            },
            {
                "PathPattern": "/datasets/complete",
                "Title": "Datasets",
                "BaseJourney": [
                    {
                        "Title": "Home",
                        "Url": "/"
                    },
                    {
                        "Title": "Datasets",
                        "Url": "/datasets"
                    }
                ]
            }
        ]
    },
    "SearchCriteria": {
        "SearchFields": [
            "TypeName"
        ],
        "Facets": [
            "searchprovidertypeid"
        ]
    },
    "FilterKeyToFilterExpressionMapOptions": {
        "SearchFilterToExpressionMap": {
            "searchprovidertypeid": {
                "FilterExpressionKey": "SearchProviderTypeFilter",
                "FilterExpressionValuesDelimiter": ""
            }
        }
    },
    "SearchConfiguration": {
        "Keys": [
            {
                "searchTermKey": "what",
                "fieldChainingPredicate": "OR",
                "indexedFields": [
                    {
                        "fieldName": "ProviderId",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "startswith" }
                        ]
                    },
                    {
                        "fieldName": "GroupUid",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "startswith" }
                        ]
                    },
                    {
                        "fieldName": "UkProviderReferenceNumber",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "startswith" }
                        ]
                    },
                    {
                        "fieldName": "CompaniesHouseNumber",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "startswith" }
                        ]
                    },
                    {
                        "fieldName": "LaEstab",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "startswith" }
                        ]
                    },
                    {
                        "fieldName": "DfeNumber",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "startswith" }
                        ]
                    },
                    {
                        "fieldName": "ProviderName",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "contains" },
                            { "name": "fuzzy" }
                        ]
                    }
                ]
            },
            {
                "searchTermKey": "where",
                "fieldChainingPredicate": "OR",
                "indexedFields": [
                    {
                        "fieldName": "Postcode",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "startswith" }
                        ]
                    },
                    {
                        "fieldName": "County",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "startswith" }
                        ]
                    },
                    {
                        "fieldName": "Town",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "startswith" }
                        ]
                    },
                    {
                        "fieldName": "LocalAuthorityName",
                        "defaultBehaviourChainingPredicate": "OR",
                        "searchBehaviours": [
                            { "name": "exact" },
                            { "name": "startswith" }
                        ]
                    }
                ]
            }
        ]
    }
}
