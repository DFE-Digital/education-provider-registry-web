@using DfE.EducationProviderRegistry.Web.Mvc.Settings
@using Microsoft.Extensions.Options

@inject IOptions<ClaritySettings> ClarityOptions

@{
    ClaritySettings clarity = ClarityOptions.Value;
    bool analyticsGranted = Context.IsAnalyticsConsentGranted();
}

@if (clarity.Enabled && !string.IsNullOrEmpty(clarity.ProjectId))
{
    <script>
        // Loads the Microsoft Clarity tag. Guarded so it only ever runs once,
        // regardless of whether it is called inline below (returning consented user)
        // or from cookies.js when the user accepts via the banner / preferences page.
        window.loadClarity = function () {
            if (window.__clarityLoaded) return;
            window.__clarityLoaded = true;
            (function (c, l, a, r, i, t, y) {
                c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
                t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
                y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
            })(window, document, "clarity", "script", "@clarity.ProjectId");
        };
    </script>
    @if (analyticsGranted)
    {
        <script>window.loadClarity();</script>
    }
}