@using DfE.EducationProviderRegistry.Web.Mvc.Settings
@using Microsoft.Extensions.Options

@inject IOptions<GoogleAnalyticsSettings> Options

@{
    var googleAnalyticsSettings = Options.Value;

    string environmentParameters = googleAnalyticsSettings.TagManagerQueryString;
}

@if (googleAnalyticsSettings.IsGoogleTagManagerEnabled(Context))
{
    <!-- Google Tag Manager -->
    <script>
        (function(w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            });
            var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = '@googleAnalyticsSettings.Domain/gtm.js?id=' + i + dl + '@Html.Raw(environmentParameters)';
            f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', '@googleAnalyticsSettings.ContainerId');
    </script>
    <!-- End Google Tag Manager -->
}