@using DfE.EducationProviderRegistry.Web.Mvc.Features.Search.ViewModels
@model SearchResultsViewModel

@{
    var selectedFacets = (Model.Facets ?? [])
        .SelectMany(facet =>
            facet.Values
                .Where(value => value.IsSelected)
                .Select(value => new
                {
                    FacetName = facet.Name,
                    Value = value.Value,
                    Label = value.Label
                }))
        .ToList();

    var dateFilters = new[]
    {
        (
            Name: "opened_date",
            Label: "Opened date",
            Range: Model.SearchRequest.Filters
        .GetValueOrDefault("opened_date")?.DateRange ?? new()),
        (
            Name: "closed_date",
            Label: "Closed date",
            Range: Model.SearchRequest.Filters
        .GetValueOrDefault("closed_date")?.DateRange ?? new()),
    };

    var ageRange = Model.SearchRequest.Filters
        .GetValueOrDefault("age_range")?.NumberRange ?? new();

    var selectedDateFilters = dateFilters
        .Where(filter => filter.Range.SelectedLabel is not null)
        .ToList();
}

<div class="moj-filter">
    <div class="moj-filter__content">
        <div class="moj-filter__options">

            @if (selectedFacets.Any() || selectedDateFilters.Any() || ageRange.SelectedLabel is not null)
            {
                <div class="moj-filter__selected app-selected-filters">
                    <div class="app-selected-filters__header">
                        <h1 class="govuk-heading-s">
                            Selected filters
                        </h1>

                        <button type="submit"
                                name="ClearFilters"
                                value="true"
                                class="govuk-link app-selected-filters__clear">
                            Clear filters
                        </button>
                    </div>

                    <ul class="app-selected-filters__list">
                        @if (ageRange.SelectedLabel is not null)
                        {
                            <li>
                                <button type="submit"
                                        class="app-selected-filter"
                                        name="RemoveFilter"
                                        value="@($"age_range|filter")">

                                    @ageRange.SelectedLabel

                                    <span aria-hidden="true">&times;</span>

                                    <span class="govuk-visually-hidden">
                                        Remove age range filter
                                    </span>
                                </button>
                            </li>
                        }
                        @foreach (var filter in selectedDateFilters)
                        {
                            <li>
                                <button type="submit"
                                        class="app-selected-filter"
                                        name="RemoveFilter"
                                        value="@($"{filter.Name}|filter")">

                                    @filter.Range.SelectedLabel

                                    <span aria-hidden="true">&times;</span>
                                    <span class="govuk-visually-hidden">
                                        Remove @filter.Label.ToLowerInvariant() filter
                                    </span>
                                </button>
                            </li>
                        }
                        @foreach (var filter in selectedFacets)
                        {
                            <li>
                                <button type="submit"
                                        class="app-selected-filter"
                                        name="RemoveFilter"
                                        value="@($"{filter.FacetName}|{filter.Value}")">

                                    @filter.Label

                                    <span aria-hidden="true">&times;</span>

                                    <span class="govuk-visually-hidden">
                                        Remove @filter.Label filter
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            }

            @foreach (var facet in Model.Facets ?? [])
            {
                <details class="govuk-details filter-section">
                    <summary class="govuk-details__summary">
                        <span class="govuk-details__summary-text">
                            @facet.Label
                        </span>
                    </summary>

                    <div class="govuk-details__text">
                        @if (facet.Name == "LocalAuthority")
                        {
                            @await Html.PartialAsync(
                                "_AutocompleteFilter",
                                facet)
                        }
                        else
                        {
                            @await Html.PartialAsync(
                                "_FiltersCheckboxComponent",
                                facet)
                        }
                    </div>
                </details>
            }

            @foreach (var filter in dateFilters)
            {
                <details class="govuk-details filter-section">
                    <summary class="govuk-details__summary">
                        <span class="govuk-details__summary-text">
                            @filter.Label
                        </span>
                    </summary>

                    @await Html.PartialAsync("_DateRangeFilter", (filter.Name, filter.Range))
                </details>
            }

            <details class="govuk-details filter-section">
                <summary class="govuk-details__summary">
                    <span class="govuk-details__summary-text">
                        Age range
                    </span>
                </summary>

                @await Html.PartialAsync("_NumberRangeFilter", ("age_range", ageRange))
            </details>

            <button type="submit"
                    class="govuk-button"
                    data-module="govuk-button">
                Apply filters
            </button>

        </div>
    </div>
</div>
