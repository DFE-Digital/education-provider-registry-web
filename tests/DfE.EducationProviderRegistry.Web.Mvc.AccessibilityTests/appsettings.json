{
  "AccessibilityTestOptions": {
    "ArtifactsOutputDirectory": "artifacts",
    "WcagTags": [
      "wcag2a",
      "wcag2aa",
      "wcag21a",
      "wcag21aa",
      "wcag22a",
      "wcag22aa"
    ],
    "Scans": {
      "Home": {
        "Actions": [
          {
            "Name": "navigate",
            "Options": {
              "route": "/"
            }
          }
        ]
      },
      "Search": {
        "Actions": [
          {
            "Name": "navigate",
            "Options": {
              "route": "/search"
            }
          }
        ]
      },
      "SearchResults": {
        "Actions": [
          {
            "Name": "navigate",
            "Options": {
              "route": "/search"
            }
          },
          {
            "Name": "enter",
            "Options": {
              "target": "#SearchKeywords",
              "text": "sch"
            }
          },
          {
            "Name": "click",
            "Options": {
              "target": ".search-panel [type=submit]"
            }
          }
        ]
      },
      "Establishment_ById": {
        "Actions": [
          {
            "Name": "navigate",
            "Options": {
              "route": "/establishments/100001"
            }
          }
        ]
      },
      "Group_ById": {
        "Actions": [
          {
            "Name": "navigate",
            "Options": {
              "route": "/groups/1"
            }
          }
        ]
      }
    }
  },
  "ApplicationHostOptions": {
    "Container": {
      "Registry": "ghcr.io",
      "Owner": "dfe-digital",
      "ImageName": "education-provider-registry-web",
      "ImageTag": "main",
      "Digest": "",
      "PortMappings": [
        {
          "ContainerPort": 8080,
          "PublicPort": null
        }
      ]
    }
  },
  "DatabaseContainerOptions": {
    "ContainerOptions": {
      "Registry": "ghcr.io",
      "Owner": "dfe-digital",
      "ImageName": "education-provider-registry-data-postgres",
      "ImageTag": "main",
      "Digest": "",
      "HostName": "epr-postgres",
      "StartupArguments": []
    },
    "PostgresDatabaseOptions": {
      "Database": "postgres",
      "Username": "postgres",
      "Password": "postgres"
    }
  }
}