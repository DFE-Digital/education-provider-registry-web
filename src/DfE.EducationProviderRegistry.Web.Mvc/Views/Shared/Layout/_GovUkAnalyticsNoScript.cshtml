@using DfE.EducationProviderRegistry.Web.Mvc.Settings
@using Microsoft.Extensions.Options

@inject IOptions<GoogleAnalyticsSettings> Options

@{
    bool analyticsGranted = Context.IsAnalyticsConsentGranted();

    var googleAnalyticsSettings = Options.Value;
}

@if (!string.IsNullOrWhiteSpace(googleAnalyticsSettings.ContainerId)
    && analyticsGranted)
{
    string environmentParameters =
        !string.IsNullOrWhiteSpace(googleAnalyticsSettings.AuthenticationId) && !string.IsNullOrWhiteSpace(googleAnalyticsSettings.PreviewValue)
            ? $"&gtm_auth={Uri.EscapeDataString(googleAnalyticsSettings.AuthenticationId)}" +
              $"&gtm_preview={Uri.EscapeDataString(googleAnalyticsSettings.PreviewValue)}" +
              "&gtm_cookies_win=x"
            : string.Empty;

    string googleTagManagerUrl =
        $"https://www.googletagmanager.com/ns.html?id={Uri.EscapeDataString(googleAnalyticsSettings.ContainerId)}{environmentParameters}";

    <!-- Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="@googleTagManagerUrl"
                title="Google Tag Manager"
                height="0"
                width="0"
                style="display:none;visibility:hidden">
        </iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
}