@{
    var breadcrumbs = new List<BreadcrumbViewModel>
    {
        new("Home", "Home", "Index"),
    };
}

@section Breadcrumbs
{
    <partial name="_Breadcrumbs" model="breadcrumbs" />
}

<div class="govuk-width-container">   
    <main class="govuk-main-wrapper" id="main-content">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <h1 class="govuk-heading-xl">Downloading from the register</h1>
                <div class="dfe-download-status">
                    <p class="govuk-body-l dfe-download-status__text" id="download-status" role="status" aria-live="polite">
                        Preparing file for download …
                    </p>
                    @await Html.PartialAsync("_Spinner", false)
                </div>
                <noscript>
                    <p class="govuk-body">
                        <a class="govuk-link" href="/download-complete">Continue to confirmation</a>
                    </p>
                </noscript>
            </div>
        </div>
    </main>
</div>

<script>
    (function() {
        const statusEl = document.getElementById('download-status');
        const spinnerEl = document.getElementById('download-spinner');

        if (!statusEl) return;

        async function poll() {
            try {
                const response = await fetch('@Url.Action("Status", "DownloadDatasets")');
                const data = await response.json();

                if (data.ready) {
                    statusEl.textContent = 'File ready, downloading …';
                    if (spinnerEl) spinnerEl.hidden = true;

                    window.location.href = '@Url.Action("Complete", "DownloadDatasets")';
                    return;
                }
            } catch (e) {
                console.error('Polling failed', e);
            }

            // Poll again in 1 second
            setTimeout(poll, 1000);
        }

        poll();
    })();
</script>

